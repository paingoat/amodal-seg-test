# Copy to .env at repo root and edit as needed:
#   cp .env.example .env
#
# Do NOT commit .env (it may contain HF_TOKEN).

# Hugging Face cache root (large disk for model weights)
HF_HOME=/backup/data/art-gen

# Optional: Hugging Face access token (or use .hf_token / huggingface-cli login)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults are fine for in-repo layout)
# LISA_OUTPUT_PATH=
# OUTPUT_DIR=
# LISA_MODEL_PATH=
# SD_MODEL_ID=sd2-community/stable-diffusion-2-inpainting
# LISA_SERVER_PORT=7860
# GRADIO_PIPELINE_PORT=7861
