# Source this file before running any pipeline scripts:
#   source scripts/paths.env
#
# Layout philosophy:
#   - Everything (code + sibling clones + local cache/output) lives under this repo root.
#   - Large HF model cache lives on a big disk via .env → HF_HOME (default /backup/data/art-gen).
#
# Create .env at repo root first (see .env.example):
#   cp .env.example .env && nano .env

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export AMODAL_ROOT="$(cd "$_SCRIPT_DIR/.." && pwd)"
export REPO_ROOT="$AMODAL_ROOT"

# ---------------------------------------------------------------------------
# Load repo-root .env (manual file; KEY=VALUE lines)
# ---------------------------------------------------------------------------
_load_dotenv() {
  local env_file="$1"
  [ -f "$env_file" ] || return 0
  echo "[paths.env] Loading $env_file"
  while IFS= read -r line || [ -n "$line" ]; do
    # trim CR
    line="${line%$'\r'}"
    # skip blank / comments
    case "$line" in
      ''|\#*) continue ;;
    esac
    # only KEY=VALUE
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      local key="${BASH_REMATCH[1]}"
      local val="${BASH_REMATCH[2]}"
      # strip optional surrounding quotes
      if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"; fi
      if [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
      export "$key=$val"
    fi
  done < "$env_file"
}

_load_dotenv "$AMODAL_ROOT/.env"

# Sibling / third-party clones live inside the repo
export MODELS_DIR="${MODELS_DIR:-$AMODAL_ROOT/third_party}"
export LISA_REPO="${LISA_REPO:-$MODELS_DIR/LISA}"
export INSTAORDER_REPO="${INSTAORDER_REPO:-$MODELS_DIR/InstaOrder}"
export GROUNDED_SAM_REPO="${GROUNDED_SAM_REPO:-$MODELS_DIR/Grounded-Segment-Anything}"
export RAM_REPO="${RAM_REPO:-$MODELS_DIR/recognize-anything}"

# Hugging Face cache — large disk (override in .env)
export HF_HOME="${HF_HOME:-/backup/data/art-gen}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
export HUGGINGFACE_HUB_CACHE="${HUGGINGFACE_HUB_CACHE:-$HF_HOME/hub}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$HF_HOME/transformers}"
export HF_HUB_CACHE="${HF_HUB_CACHE:-$HUGGINGFACE_HUB_CACHE}"

# Token: prefer env / .env; fallback to repo-root .hf_token
if [ -z "${HF_TOKEN:-}" ] && [ -f "$AMODAL_ROOT/.hf_token" ]; then
  export HF_TOKEN="$(tr -d '[:space:]' < "$AMODAL_ROOT/.hf_token")"
fi
if [ -n "${HF_TOKEN:-}" ]; then
  export HUGGING_FACE_HUB_TOKEN="$HF_TOKEN"
fi

# In-repo working dirs (masks, outputs, LISA vis)
export LISA_OUTPUT_PATH="${LISA_OUTPUT_PATH:-$AMODAL_ROOT/cache/lisa_masks}"
export LISA_VIS_PATH="${LISA_VIS_PATH:-$AMODAL_ROOT/cache/lisa_vis}"
export OUTPUT_DIR="${OUTPUT_DIR:-$AMODAL_ROOT/output}"
export LISA_SERVER_URL="${LISA_SERVER_URL:-http://127.0.0.1:7860/}"
export LISA_SERVER_PORT="${LISA_SERVER_PORT:-7860}"
export LISA_MODEL_PATH="${LISA_MODEL_PATH:-$LISA_REPO/LISA-13B-llama2-v1}"

export GRADIO_PIPELINE_PORT="${GRADIO_PIPELINE_PORT:-7861}"

# Checkpoints under third_party clones
export GDINO_CONFIG="${GDINO_CONFIG:-$GROUNDED_SAM_REPO/GroundingDINO/groundingdino/config/GroundingDINO_SwinT_OGC.py}"
export GDINO_CKPT="${GDINO_CKPT:-$GROUNDED_SAM_REPO/groundingdino_swint_ogc.pth}"
export SAM_CKPT="${SAM_CKPT:-$GROUNDED_SAM_REPO/sam_vit_h_4b8939.pth}"
export INSTAORDER_CKPT="${INSTAORDER_CKPT:-$INSTAORDER_REPO/InstaOrder_ckpt/InstaOrder_InstaOrderNet_od.pth.tar}"
export RAM_CKPT="${RAM_CKPT:-$RAM_REPO/ram_plus_swin_large_14m.pth}"

export SD_MODEL_ID="${SD_MODEL_ID:-sd2-community/stable-diffusion-2-inpainting}"

export AMODAL_ENV_NAME="${AMODAL_ENV_NAME:-amodal}"
export LISA_ENV_NAME="${LISA_ENV_NAME:-lisa}"

export TORCH_INDEX_URL="${TORCH_INDEX_URL:-https://download.pytorch.org/whl/cu132}"
export TORCH_VERSION="${TORCH_VERSION:-2.13.0}"
export TORCHVISION_VERSION="${TORCHVISION_VERSION:-0.28.0}"

# Compat alias (older scripts)
export WORKSPACE_ROOT="${WORKSPACE_ROOT:-$AMODAL_ROOT}"

mkdir -p "$MODELS_DIR" "$LISA_OUTPUT_PATH" "$LISA_VIS_PATH" "$OUTPUT_DIR"
mkdir -p "$HF_HOME" 2>/dev/null || echo "[paths.env] WARN: cannot mkdir HF_HOME=$HF_HOME (create it or fix .env)"

echo "[paths.env] AMODAL_ROOT=$AMODAL_ROOT"
echo "[paths.env] MODELS_DIR=$MODELS_DIR"
echo "[paths.env] HF_HOME=$HF_HOME"
echo "[paths.env] LISA_OUTPUT_PATH=$LISA_OUTPUT_PATH"
echo "[paths.env] OUTPUT_DIR=$OUTPUT_DIR"
echo "[paths.env] LISA port=$LISA_SERVER_PORT | Gradio port=$GRADIO_PIPELINE_PORT"
